# EnglishTalker web frontend — environment configuration.
# Copy to `.env.local` (gitignored) and adjust for your setup.

# Base URL of the FastAPI backend's versioned REST API.
# Note: use 127.0.0.1, not localhost — uvicorn binds the IPv4 loopback by default.
# The WebSocket base (ws/wss) is derived from this automatically.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
