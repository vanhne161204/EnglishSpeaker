{
  "expo": {
    "name": "EnglishTalker",
    "slug": "englishtalker",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "englishtalker",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0EA5E9"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.englishtalker.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "EnglishTalker uses your microphone for voice conversations in rooms."
      },
      "bitcode": false
    },
    "android": {
      "package": "com.englishtalker.app",
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "extra": {
      "apiBaseUrl": null,
      "turnUrl": null,
      "turnUsername": null,
      "turnCredential": null,
      "eas": {
        "projectId": "757df8e4-1ba0-46f8-b232-1ed47b97068a"
      }
    },
    "plugins": [
      "expo-dev-client",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": false,
          "microphonePermission": "EnglishTalker uses your microphone for voice conversations in rooms."
        }
      ]
    ]
  }
}
