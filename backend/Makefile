.PHONY: install run test lint format migrate revision seed up down

install:        ## Install runtime + dev dependencies
	pip install -r requirements-dev.txt

run:            ## Run the API with autoreload
	uvicorn app.main:app --reload

test:           ## Run the test suite
	pytest

lint:           ## Lint + type-check
	ruff check . && mypy app

format:         ## Auto-fix lint issues and format
	ruff check --fix . && ruff format .

migrate:        ## Apply all migrations
	alembic upgrade head

revision:       ## Create an autogenerated migration: make revision m="message"
	alembic revision --autogenerate -m "$(m)"

up:             ## Start full local stack (API + Postgres + Redis)
	docker compose up --build

down:           ## Stop the stack
	docker compose down
