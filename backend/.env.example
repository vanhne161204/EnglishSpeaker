# Copy to .env and adjust as needed.
#
#   cd backend && cp .env.example .env
#
# .env is gitignored (see .gitignore) — never commit real keys.

ENVIRONMENT=development
DEBUG=true
APP_NAME=EnglishTalker API
API_V1_PREFIX=/api/v1

# Zero-setup default (SQLite, no infrastructure required):
DATABASE_URL=sqlite+aiosqlite:///./englishtalker.db
# Production stack (Postgres + pgvector) — uncomment and use migrations:
# DATABASE_URL=postgresql+asyncpg://englishtalker:englishtalker@localhost:5432/englishtalker

REDIS_URL=redis://localhost:6379/0

# Dev convenience only. Set false in staging/production and run Alembic.
AUTO_CREATE_TABLES=true

SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=["*"]
GITHUB_TOKEN=change-me


# ==========================================================================
# AI providers  (docs/18_AI_Provider_Architecture.md)
# ==========================================================================
#
# Set EITHER key below and the app uses it. Set neither and every AI feature
# degrades to a clearly-labelled demo stub — the app still runs.

# --- OpenAI (ChatGPT) -----------------------------------------------------
# Get a key: https://platform.openai.com/api-keys   (looks like sk-proj-...)
# Add credit first: https://platform.openai.com/settings/organization/billing
# A new key with no credit returns 429 insufficient_quota on the first call.
OPENAI_API_KEY=sk-proj-replace-me

# --- Anthropic (Claude) --- STRONGLY RECOMMENDED -------------------------
# Get a key: https://console.anthropic.com/settings/keys   (sk-ant-...)
#
# With only OPENAI_API_KEY set your chain is "openai -> stub": if OpenAI has an
# outage or rate-limits you, every AI feature drops to the demo placeholder.
# A second vendor is the whole point of the provider layer — one key is one
# point of failure for the entire AI surface.
# ANTHROPIC_API_KEY=sk-ant-replace-me

# --- Which model runs which task ------------------------------------------
# ONE knob. Defaults are in app/ai/routing.py; this patches individual entries
# without a deploy. Only the fields you name are replaced.
#   AI_ROUTES='{"rescue:free":{"chain":["openai:gpt-4o-mini"],"timeout_s":3.0}}'
#
# MEASURED 2026-08-29 — the list price lies:
#   gpt-4o-mini   median 1314 ms   $0.000011/call   <-- cheapest in practice
#   gpt-5-nano    median 1752 ms   $0.000052/call   5x DEARER despite a 3x lower
#                 (spikes to 5.7s)                  list price: a reasoning model
#                                                   billing ~150 invisible
#                                                   thinking tokens per sentence.
# AI_ROUTES=

# Org-wide 30-day spend ceiling in USD. AI is refused above it; a warning is
# logged at 70%. Do NOT ship with 0 (unlimited) — a looping bug should cost you
# an alert, not a month of runway.
AI_MONTHLY_BUDGET_USD=50

# Master kill switch. false => every AI task uses the stub, no API calls, no
# spend. The app keeps working; only the AI extras go quiet. The test suite
# forces this to false so CI never touches a live API.
AI_ENABLED=true


# ==========================================================================
# Speech-to-Text  (docs/10_AI_Design.md §8.9)
# ==========================================================================
# whisper = offline faster-whisper (free, CPU-heavy) | deepgram | stub
STT_PROVIDER=whisper
STT_MODEL=base
# DEEPGRAM_API_KEY=

# ==========================================================================
# Translation  (in-room translator)
# ==========================================================================
# google (default) | argos | claude | stub | auto
TRANSLATION_PROVIDER=google
# Official Google Cloud Translation key. Unset = free public endpoint
# (no key, but unofficial and rate-limited).
# GOOGLE_TRANSLATE_API_KEY=
