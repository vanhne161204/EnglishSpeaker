# Production environment for the API (see docs/DEPLOYMENT.md §11).
# Copy this to `.env.prod` ON THE EC2, fill in the real values, then `chmod 600 .env.prod`.
# NEVER commit the real .env.prod — only this .example is tracked.

ENVIRONMENT=production
DEBUG=false

# Signing secret for JWTs. Generate with: openssl rand -hex 32
# The app refuses to start in production if this is left as the default.
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32

AUTO_CREATE_TABLES=false
SEED_DEMO_DATA=false

# Only your frontend origin may call the API.
CORS_ORIGINS=["https://englishspeaker.me"]

# Speech-to-text: "tiny" fits a 2 GB (t3.small) box; use "base" on 4 GB+.
STT_MODEL=tiny

# Database (Postgres container on this box). Use a strong password.
POSTGRES_USER=englishtalker
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=englishtalker
DATABASE_URL=postgresql+asyncpg://englishtalker:CHANGE_ME_strong_password@db:5432/englishtalker

REDIS_URL=redis://redis:6379/0

# Username(s) that become admin on register/login.
ADMIN_USERNAMES=["your-admin-username"]

# Optional — only if you enable the AI coach (costs $ per call).
# ANTHROPIC_API_KEY=sk-ant-...
